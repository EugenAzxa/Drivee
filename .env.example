# Copy to .env.local and fill in. .env.local is gitignored.

# Ticket scanner (Anthropic). Required for /api/scan-ticket.
CLAUDE_API_KEY=sk-ant-...

# Lead + contact email (Resend). Required for /api/lead and /api/contact.
RESEND_API_KEY=re_...

# Analytics & Durable VIN Production Store (Supabase Postgres)
# Public anon key is for browser/funnel analytics; SERVICE_ROLE_KEY is strictly
# server-side for the RLS-locked `public.vin_store_buckets` table (run tools/vin-supabase-schema.sql once).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram alerts on conversions (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe + VIN Automated Reports (server-side only — never expose in client bundles)
NEXT_PUBLIC_SITE_URL=https://www.drivee.ca
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VIN_AUTO_FULFILL=false
VIN_ACCESS_SECRET=
VIN_ADMIN_USER=admin
VIN_ADMIN_PASSWORD=
VIN_ADMIN_KEY=
VIN_ALLOW_FREE_PROMO=false
CAD_TO_USD_RATE=0.72
AUCTIONS_API_KEY=
